# Local dev defaults. For production (Vercel), set these as Environment
# Variables in the Vercel project dashboard, pointing at your deployed
# Render backend, e.g.:
#   VITE_API_URL=https://your-server.onrender.com/api
#   VITE_SOCKET_URL=https://your-server.onrender.com
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
