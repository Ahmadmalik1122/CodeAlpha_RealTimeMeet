PORT=5000

MONGODB_URI=

JWT_SECRET=

# ===================== EMAIL VERIFICATION / RESET =====================
# Where the React app is served. Verification and reset links point here,
# NOT at the API, because /verify-email/:token and /reset-password/:token
# are client-side routes. Also used for CORS (both Express and Socket.IO).
# Comma-separate multiple origins, e.g. for local dev + the deployed site:
# CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ===================== FIREBASE ADMIN =====================
# Paste the ENTIRE contents of your firebase-service-account.json as a
# single-line JSON string here for deployment (Render, Railway, etc — the
# real .json file is gitignored and won't exist on the server). Leave unset
# for local dev if you have the actual file at
# server/config/firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT=

# SMTP. Leave SMTP_HOST blank/absent to use an Ethereal dev inbox, which
# prints a preview URL to the server console instead of delivering mail.
# For Gmail, SMTP_USER is your full address and SMTP_PASS must be a 16-char
# App Password (Google Account > Security > 2-Step Verification > App
# Passwords) with 2FA enabled — your normal account password will fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RealTime Collab <no-reply@realtimecollab.app>"

VERIFICATION_TOKEN_EXPIRY_HOURS=24
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=60
PASSWORD_RESET_COOLDOWN_SECONDS=60
